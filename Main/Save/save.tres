[resource]
script = ExtResource("1_vny5t")
Stop_at = 2
Code = "class Matrix {
	public variable list rows
	public variable integer x
	public variable integer y
	constructor(list data) {
		rows = data
		x = rows[0].size
		y = rows.size
	}
	public function Matrix remove_column(integer index) {
		for (i in y) {
			rows[i].remove(index)
		}
		x -= 1
		return Matrix(rows)
	}
	public function Matrix remove_row(integer index) {
		rows.remove(index)
		y -= 1
		return Matrix(rows)
	}
	public function void set_column(integer index, list data) {
		for (i in y) {
			rows[i][index] = data[i]
		}
	}
	public function void set_row(integer index, list data) {
		rows[index] = data
	}
	public function list get_column(integer index) {
		variable list data = []
		for (i in y) {
			data.append(rows[i][index])
		}
		return data
	}
	public function list get_row(integer index) {
		return rows[index]
	}
	public function Matrix duplicate() {
		variable list new_rows = []
		for (row in rows) {
			variable list new_row = []
			for (number in row) {
				new_row.append(number)
			}
			new_rows.append(new_row)
		}
		return Matrix(new_rows)
	}
	public function float determinant() {
		if (x == y) {
			variable float determinant = 0
			if (x == 2) {
				determinant += (rows[0][0] * rows[1][1]) - (rows[1][0] * rows[0][1])
			}
			else {
				for (i in y) {
					variable variant A = duplicate()
					A = A.remove_row(0)
					A = A.remove_column(i)
					variable float D = A.determinant()
					if (i % 2 == 0) {
						determinant += rows[0][i] * D
					}
					 else {
						determinant += rows[0][i] * D * -1
					}
				}
			}
			return determinant
		}
		return 99999
	}
	public function Matrix multiply(Matrix otherMatrix) {
		if (x == otherMatrix.y) {
			variable list result = []
			for (i in y) {
				variable list newRow = []
				for (k in otherMatrix.x) {
					variable integer newElement = 0
					for (j in x) {
						newElement += rows[i][j] * otherMatrix.rows[j][k]
					}
					newRow.append(newElement)
				}
				result.append(newRow)
			}
			return Matrix(result)
		}
	}
	
	public function string to_string() {
		variable string output = ''
		for (row in rows) {
			output += '|'
			for (number in row) {
				output += number + ', '
			}
			output += '|
'
		}
		return output
	}
}
variable list x2 = [
	[1, 2],
	[3, 4]
]
variable list x3 = [
	[1, 20, 3],
	[40, 5, 60],
	[7, 80, 9]
]
variable Matrix Matrix_A = Matrix(x2)
variable Matrix Matrix_B = Matrix(x3)
PrintLine(\"The determinant of Matrix A is:\", Matrix_A.determinant())
PrintLine(\"The determinant of Matrix B is:\", Matrix_B.determinant())
"
