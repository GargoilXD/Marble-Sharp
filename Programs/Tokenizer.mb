class NumberToken {
	public integer value
	constructor(integer number) {
		value = number
	}
	function string to_string() {
		return "(" + value + "), "
	}
}
class OperatorToken {
	public string value
	constructor(string operator) {
		value = operator
	}
	function string to_string() {
		return "(" + value + "), "
	}
}
function void NextCharacter() {
	Index += 1
	Character = if (Index < String.size) String[Index] else "End"
}

function NumberToken MakeNumberToken() {
	string data = ""
	while (NUMBERS.has(Character)) {
		data += Character
		NextCharacter()
	}
	return NumberToken(data)
}
function OperatorToken MakeOperatorToken() {
	string operator = Character
	NextCharacter()
	if (operator == "+") {
		return OperatorToken("ADD")
	} elseif (operator == "-") {
		return OperatorToken("SUBTRACT")
	} elseif (operator == "*") {
		return OperatorToken("MULTIPLY")
	} elseif (operator == "/") {
		return OperatorToken("DIVIDE")
	}
}
function void Run() {
	String = Input("Enter the data:")
	NextCharacter()
	while (Character != "End") {
		if (Character == " ") {
			NextCharacter()
		}
		elseif (NUMBERS.has(Character)) {
			Tokens.append(MakeNumberToken())
		} elseif (OPERATORS.has(Character)) {
			Tokens.append(MakeOperatorToken())
			
		} else {
			PrintLine("Invalid Input")
			break
		}
	}
	for (token in Tokens) {
		Print(token)
	}
}
string NUMBERS = "1234567890"
string OPERATORS = "+-*/"
string String
string Character
integer Index = -1
list Tokens = []
Run()
