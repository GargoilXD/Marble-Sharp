#
class Human {
	public variable integer Age
	public variable string Gender
	public constructor(integer age, string gender) {
		Age = age
		Gender = gender
	}
}
class Human Person {
	public variable string First_name
	public variable string Last_name
	public constructor(string first_name, string last_name, integer age, string gender) : (age, Gender) {
		First_name = first_name
		Last_name = last_name
	}
	public function string to_string() {
		return First_name + " " + Last_name + " " + Age + " " + Gender
	}
	public function void speak(string sentence) {
		Print(First_name + ": " + sentence)
	}
	public function void give_ID() {
		speak("My name is " + First_name + " " + Last_name + ", I am " + Age + " Years old and I am a " + Gender)
	}
}
variable Person Person_A = Person("Mary", "Underling", 19, "Femoid")
Person_A.speak("I'm alive!!")
Person_A.give_ID()
variable Person Person_B = Person("Kweku", "Ananse", 500, "Spider")
Person_B.speak("I'm alive!!")
Person_B.give_ID()
