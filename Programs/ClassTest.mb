variable string x = $"fngfgnf: {x}"
variable callable func = function (string x) {
	return x
}

variable string x = if (x == 0) => "HI" else => "Bye"
for (x in [0, 2, 2]) => Print("Hi")
function integer add(classified [integer left, integer right]) {
	return a + b
}
add(right:3, left:4)
function string combine(unlimited words) {
	string combination = ""
	for (word in words) {
		combination += word
	}
	return combination
}
combine("asdsa", "asfdsad", "adasdasd")

function string show_students(classified unlimited names) {
	string students = ""
	for (name, age in names) => students += $"{name}: {age}"
	return students
}
show_students(kobby:334, kwame:423)
function void test(classified unlimited names, classified [integer left, integer right]) => 5




